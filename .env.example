# Variables de entorno (Vercel > Settings > Environment Variables). NO subas un .env real al repositorio.

# Contraseña de acceso al panel
ADMIN_PASSWORD=cambia-esta-contraseña

# Cadena aleatoria larga para firmar la sesión (mínimo 16 caracteres).
# Para generarla:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Repositorio del sitio público de verificación y un token con permiso de escritura SOLO sobre ese repo
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=LesJNS/tcg-certificados
GITHUB_BRANCH=main
PUBLIC_DIR=publico

# Dirección pública del sitio de verificación (va dentro del QR)
BASE_URL=https://tcg-certificados.vercel.app
